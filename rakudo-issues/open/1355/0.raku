         -> +l { l }(  [1, (2, 3)]      ) = (1, $(2, 3))
         -> +l { l }(  (1, (2, 3))      ) = (1, (2, 3))
         -> +l { l }(  (1, (2, 3)).Seq  ) = (1, (2, 3)).Seq

       -> +@l { @l }(  [1, (2, 3)]      ) = [1, (2, 3)]
       -> +@l { @l }(  (1, (2, 3))      ) = [1, (2, 3)]
       -> +@l { @l }(  (1, (2, 3)).Seq  ) = (1, (2, 3))

-> +@l is raw { @l }(  [1, (2, 3)]      ) = (1, $(2, 3))
-> +@l is raw { @l }(  (1, (2, 3))      ) = (1, (2, 3))
-> +@l is raw { @l }(  (1, (2, 3)).Seq  ) = (1, (2, 3)).Seq
